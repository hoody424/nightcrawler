# Copy to .env - docker compose reads it automatically. All values are optional.

# --- AI: Claude Pro/Max subscription (recommended) ---------------------------
# Create a long-lived token with `claude setup-token` (on any machine with Claude Code,
# or: docker compose exec -it nightcrawler claude setup-token) and paste it here.
# You can also paste it in the web UI under Settings → AI instead.
CLAUDE_CODE_OAUTH_TOKEN=

# --- AI: Anthropic API key (alternative, billed per token) ---------------------
ANTHROPIC_API_KEY=

# --- eBay Browse API (https://developer.ebay.com → Application keys → Production)
EBAY_ENABLED=false
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# --- Protect the web UI with HTTP basic auth (recommended when exposed) -------
NIGHTCRAWLER_USERNAME=
NIGHTCRAWLER_PASSWORD=

TZ=Europe/Berlin
